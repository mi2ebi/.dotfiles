(defcfg
  process-unmapped-keys yes
  allow-hardware-repeat false
  sequence-timeout 3000
  sequence-input-mode visible-backspaced
  sequence-backtrack-modcancel no
)

(defsrc
  esc  f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  caps a    s    d    f    g    h    j    k    l    ;    '    ret
  lsft z    x    c    v    b    n    m    ,    .    /    rsft
  lctl lmet lalt           spc            ralt rctl left down up   rght
  home end  ins  del
)

(defalias
  sld (tap-hold 200 200 sldr ralt)
  trm (tap-hold 200 200 nop0 rctl)
)

(deflayer base
  esc  f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  caps a    s    d    f    g    h    j    k    l    ;    '    ret
  lsft z    x    c    v    b    n    m    ,    .    /    rsft
  lctl lmet lalt           spc            @sld @trm left down up   rght
  home end  ins  del
)

(include seqs.kbd)
